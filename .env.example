# ── Backend (server/.env) ──────────────────────────────────
PORT=5000
MONGODB_URI=mongodb://username:password@cluster-shard-00-00.mongodb.net:27017,cluster-shard-00-01.mongodb.net:27017,cluster-shard-00-02.mongodb.net:27017/weatherapp?ssl=true&replicaSet=atlas-xxxxx&authSource=admin&appName=weatherapp
OPENWEATHER_API_KEY=your_openweathermap_api_key
YOUTUBE_API_KEY=your_youtube_data_api_v3_key
GOOGLE_MAPS_API_KEY=your_google_maps_embed_api_key

# ── Frontend (client/.env.local) ───────────────────────────
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000/api
NEXT_PUBLIC_OPENWEATHER_API_KEY=your_openweathermap_api_key
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_embed_api_key